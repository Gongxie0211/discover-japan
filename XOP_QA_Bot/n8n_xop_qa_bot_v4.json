    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\n\n// Gemini の Markdown を Telegram HTML に変換\nfunction mdToHtml(text) {\n  return text\n    // コードブロック（```）\n    .replace(/```[\\s\\S]*?```/g, m => `<pre>${m.replace(/```/g, '').trim()}</pre>`)\n    // インラインコード\n    .replace(/`([^`]+)`/g, '<code>$1</code>')\n    // 太字 **text** or __text__\n    .replace(/\\*\\*(.+?)\\*\\*/g, '<b>$1</b>')\n    .replace(/__(.+?)__/g, '<b>$1</b>')\n    // 斜体 *text* or _text_\n    .replace(/\\*(.+?)\\*/g, '<i>$1</i>')\n    .replace(/_([^_]+)_/g, '<i>$1</i>')\n    // 見出し → 太字\n    .replace(/^#{1,3} (.+)$/gm, '<b>$1</b>')\n    // 箇条書き - → •\n    .replace(/^[\\-\\*] /gm, '• ')\n    // HTML特殊文字のエスケープ（変換後の < > は除外）\n    // ※ <b> <i> <code> <pre> は既に挿入済みなのでそのまま\n    .trim();\n}\n\nconst rawAnswer = response.candidates?.[0]?.content?.parts?.[0]?.text\n  || 'エラー：回答を取得できませんでした';\n\nconst answer  = mdToHtml(rawAnswer);\nconst chatId  = $('🧩 プロンプト構築 (Wiki+DB)').first().json.chatId;\nconst question = $('🧩 プロンプト構築 (Wiki+DB)').first().json.question;\nconst wikiCount  = $('🧩 プロンプト構築 (Wiki+DB)').first().json.wikiFileCount;\nconst dealsCount = $('🧩 プロンプト構築 (Wiki+DB)').first().json.dealsCount;\nconst tasksCount = $('🧩 プロンプト構築 (Wiki+DB)').first().json.tasksCount;\n\nconst footer = `\\n\\n<i>参照: Wiki${wikiCount}件 / 案件${dealsCount}件 / タスク${tasksCount}件</i>`;\nconst text = `💡 <b>XOP Bot</b>\\n\\n❓ <b>${question}</b>\\n\\n${answer}${footer}`;\n\nreturn { chatId, text, question, answer: rawAnswer };  // ログ用にrawAnswerを保持\n"
      },
      "id": "2d1af2f5-36c0-4972-a879-fbef7af82207",
