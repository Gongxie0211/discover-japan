      "id": "f4a2b8c1-3e5d-4f67-9012-a8b7c6d5e4f3",
      "name": "🔀 Merge (Wiki+Deals+Tasks)",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        80,
        16
      ]
    },
    {
      "parameters": {
        "jsCode": "// 現在日時（JST = UTC+9）\nconst jstNow = new Date(Date.now() + 9 * 60 * 60 * 1000);\nconst todayStr = jstNow.toISOString().slice(0, 10); // YYYY-MM-DD\nconst nowStr   = jstNow.toISOString().slice(0, 16).replace('T', ' '); // YYYY-MM-DD HH:MM\n\nconst question = $('🔤 テキスト正規化').first().json.question;\nconst chatId   = $('🔤 テキスト正規化').first().json.chatId;\nconst username = $('🔤 テキスト正規化').first().json.username;\n\n// 1. Wiki\nconst wikiData = $('📚 Wiki取得 (GAS)').first().json;\nconst wikiContent = wikiData.success ? wikiData.content : '(Wiki取得失敗)';\n\n// 2. Deals\nlet dealsText = '## 現在の案件パイプライン\\n';\nlet dealsCount = 0;\ntry {\n  const dealsData = $('💼 Deals取得 (NocoDB)').first().json;\n  dealsCount = dealsData.list?.length || 0;\n  if (dealsCount > 0) {\n    dealsData.list.forEach(deal => {\n      const fields = Object.entries(deal)\n        .filter(([k]) => !k.startsWith('nc_') && k !== 'Id' && deal[k])\n        .map(([k, v]) => `  ${k}: ${v}`)\n        .join('\\n');\n      dealsText += `\\n### 案件ID: ${deal.Id}\\n${fields}\\n`;\n    });\n    dealsText += `\\n合計 ${dealsCount} 件（完了除く）`;\n  } else {\n    dealsText += '現在アクティブな案件なし';\n  }\n} catch(e) {\n  dealsText += '(取得スキップ)';\n}\n\n// 3. Tasks\nlet tasksText = '## 未完了タスク一覧\\n';\nlet tasksCount = 0;\ntry {\n  const tasksData = $('✅ Tasks取得 (NocoDB)').first().json;\n  tasksCount = tasksData.list?.length || 0;\n  if (tasksCount > 0) {\n    tasksData.list.forEach(task => {\n      const fields = Object.entries(task)\n        .filter(([k]) => !k.startsWith('nc_') && k !== 'Id' && task[k])\n        .map(([k, v]) => `  ${k}: ${v}`)\n        .join('\\n');\n      tasksText += `\\n### タスクID: ${task.Id}\\n${fields}\\n`;\n    });\n    tasksText += `\\n合計 ${tasksCount} 件（Done除く）`;\n  } else {\n    tasksText += '未完了タスクなし';\n  }\n} catch(e) {\n  tasksText += '(取得スキップ)';\n}\n\n// 4. System Prompt\nconst systemPrompt = `あなたはプロテケアXOP（株式会社クラックス）の社内AIアシスタントです。\n以下の情報源を使って、質問に日本語で答えてください。\n\n【現在日時】${nowStr} JST（今日は ${todayStr} です）\n「今日」「今週」「明日」などの相対日付は、必ずこの日付を基準に判断すること。\n\n【ルール】\n- 数字（価格・スペック・日付）は正確に引用する\n- 情報がない場合は「記録にありません。詳細は宮脇さんへご確認ください」と答える\n- 回答は箇条書きで整理する（質問が複数ある場合はすべてに答える）\n- 内部文書なので社外秘データもそのまま回答してよい\n\n【音声誤認識の補正】\n\"ゾップ\"→\"XOP\"、\"プロテカ\"→\"プロテケア\"、\"クラック\"→\"クラックス\" などの誤認識を自動補正して解釈すること。\n\n━━━━━━━━━━━━━━━━━━━━━━━━\n【情報源1: XOP製品・戦略Wiki】\n${wikiContent}\n\n━━━━━━━━━━━━━━━━━━━━━━━━\n【情報源2: 案件パイプライン（リアルタイム）】\n${dealsText}\n\n━━━━━━━━━━━━━━━━━━━━━━━━\n【情報源3: タスク管理（リアルタイム）】\n${tasksText}`;\n\nconst userMessage = `【質問者】${username}\\n【質問】${question}`;\n\nreturn {\n  chatId,\n  question,\n  username,\n  systemPrompt,\n  userMessage,\n  wikiFileCount: wikiData.fileCount || 0,\n  dealsCount,\n  tasksCount\n};"
      },
      "id": "3d75165d-eee4-474b-b675-cf3c5159b855",
      "name": "🧩 プロンプト構築 (Wiki+DB)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
