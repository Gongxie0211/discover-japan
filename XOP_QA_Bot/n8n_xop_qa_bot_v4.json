      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googlePalmApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"system_instruction\": {\n    \"parts\": [{\"text\": {{ JSON.stringify($json.systemPrompt) }}}]\n  },\n  \"contents\": [\n    {\n      \"role\": \"user\",\n      \"parts\": [{\"text\": {{ JSON.stringify($json.userMessage) }}}]\n    }\n  ],\n  \"generationConfig\": {\n    \"maxOutputTokens\": 8192,\n    \"temperature\": 0.3\n  }\n}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "7acf7b3d-8ad0-45a4-b843-51d1b6c2ce56",
      "name": "🤖 Gemini API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        448,
        16
      ],
      "credentials": {
