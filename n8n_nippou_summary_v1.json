        }
      },
      "id": "wf11_noco_update",
      "name": "NocoDB: Mark Processed",
      "type": "n8n-nodes-base.nocoDb",
      "typeVersion": 3,
      "position": [3940, 800],
      "credentials": {
        "nocoDbApiToken": {
          "id": "REPLACE_NOCODB_CRED_ID",
          "name": "NocoDB - anotherstory"
        }
      }
    },
    {
      "parameters": {
        "chatId": "REPLACE_MIYAWAKI_CHAT_ID",
        "text": "={{ $('Aggregate All Reports').first().json.message }}",
        "additionalFields": { "appendAttribution": false }
      },
      "id": "wf11_tg_miyawaki",
      "name": "Telegram: Summary to 宮脇",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [3940, 600],
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_TELEGRAM_ADMIN_CRED_ID",
          "name": "Telegram - AdminBot"
        }
      }
    }
  ],
